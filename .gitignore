yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# font source kits (only the used files ship in src/fonts)
/BespokeStencil_Complete
/oh-my-notes-font

